# API base including version prefix
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Server-only upstream used by the production same-origin proxy.
# Set this in Vercel to the Railway origin without /api/v1.
BACKEND_API_URL=https://your-api.up.railway.app

# Optional Stripe publishable key for future embedded Stripe.js UI.
# The current Stripe-hosted Checkout redirect does not require this key in the frontend.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional USDA FoodData Central key for real nutrition (server-only)
# Get a free key: https://fdc.nal.usda.gov/api-key-signup.html
# USDA_API_KEY=

# Optional browser Sentry DSN (install @sentry/browser if enabling)
# NEXT_PUBLIC_SENTRY_DSN=
